# Copy to .env.local. Every block is optional: without it the site still runs,
# the matching feature just shows its "not connected yet" state.

# Public site origin. Used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form ------------------------------------------------------------
# The form is the academy's second booking channel, so this block matters.
# Without a key OR without CONTACT_TO the form still accepts messages and logs
# them server side, but nobody at the academy is emailed.
RESEND_API_KEY=
# An ordinary inbox the academy reads. NOT the PEC address: Italian certified
# mailboxes reject ordinary mail, so enquiries sent there would bounce.
CONTACT_TO=
# A sender on a domain verified in Resend.
CONTACT_FROM=

# --- Welcome video (optional) ------------------------------------------------
# Mux playback ID for Amira's welcome message on the homepage. Empty shows the
# still with a caption instead of a player.
NEXT_PUBLIC_WELCOME_VIDEO_ID=
