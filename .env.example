# Copy to .env.local. Every block is optional: without it the site still runs,
# the matching feature just shows its "not connected yet" state.

# Public site origin. Used for canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form ------------------------------------------------------------
# The form is the academy's second booking channel, so this block matters.
# Without a key OR without CONTACT_TO the form still accepts messages and logs
# them server side, but nobody at the academy is emailed.
RESEND_API_KEY=
# An ordinary inbox the academy reads. NOT the PEC address: Italian certified
# mailboxes reject ordinary mail, so enquiries sent there would bounce.
CONTACT_TO=
# A sender on a domain verified in Resend.
CONTACT_FROM=

# --- Welcome video (optional) ------------------------------------------------
# Mux playback ID for Amira's welcome message on the homepage. Empty shows the
# still with a caption instead of a player.
NEXT_PUBLIC_WELCOME_VIDEO_ID=

# --- Admin panel -------------------------------------------------------------
# UNLIKE EVERY BLOCK ABOVE, THIS ONE IS NOT OPTIONAL. From the content
# migration onwards the site's copy is read from this database, so a build
# without DATABASE_URL fails rather than serving a site with no words on it.
#
# Any Postgres will do. Use the direct connection string for `db:migrate` and
# `seed:users`; a pooled one is fine for the application, which sets
# `prepare: false` so a transaction pooler works.
DATABASE_URL=

# The two accounts `npm run seed:users` creates. Both are made with
# must_change_password = true, so these passwords are one-time handover tokens
# and not credentials. Leave a password blank and the script generates a strong
# one and prints it once.
ADMIN_OWNER_EMAIL=
ADMIN_OWNER_PASSWORD=
ADMIN_OWNER_NAME=Amira Bechini
ADMIN_EDITOR_EMAIL=
ADMIN_EDITOR_PASSWORD=
ADMIN_EDITOR_NAME=

# Signs the admin session cookie. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Changing it signs everybody out, which is the fastest way to end every session
# at once if a laptop goes missing.
AUTH_SECRET=
