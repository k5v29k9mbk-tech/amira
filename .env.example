# Copy to .env.local. Every block is optional: without it the site still runs,
# the matching feature just shows its "not connected yet" state.

# Public site origin, used for Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase: accounts, enrollments, progress -------------------------------
# Settings -> API Keys. The new "publishable" key goes in the ANON slot and the
# new "secret" key in the SERVICE_ROLE slot; both are drop-in replacements for
# the legacy anon / service_role keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe: payments --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Stripe Price ID per course.
STRIPE_PRICE_BROW=
STRIPE_PRICE_LIP=
STRIPE_PRICE_VIP=

# --- Mux: HD video -----------------------------------------------------------
# Signing key for private playback. Without it only public playback IDs work.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# --- Certificates ------------------------------------------------------------
# Salt for the public verification code. Change it before going live.
CERTIFICATE_SECRET=

# --- Contact form ------------------------------------------------------------
# Without a key the form still accepts messages and logs them server side.
RESEND_API_KEY=
CONTACT_TO=studio@amira-bechini.com
CONTACT_FROM=site@amira-bechini.com
